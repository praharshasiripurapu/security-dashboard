# ─────────────────────────────────────────────────────────────
# SecurityDash — Environment Variables  (copy to .env)
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=secuser
POSTGRES_PASSWORD=your-strong-db-password-here
POSTGRES_DB=securitydash
DATABASE_URL=postgresql://secuser:your-strong-db-password-here@db:5432/securitydash

# API key for /report/* endpoints (REQUIRED — no default in production)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-api-key-here

# App user passwords (hashed by bcrypt at startup)
ADMIN_PASSWORD=Admin@123
ANALYST_PASSWORD=Analyst@456

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# Grafana SMTP (optional — for email alerts)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=whatsappwhy1@gmail.com
SMTP_PASSWORD=bbbbwxalkxfpztud
ALERT_EMAIL_FROM=grafana@yourdomain.com
ALERT_EMAIL_TO=psiripur@gmail.com
# Slack webhook (optional — for Slack alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
