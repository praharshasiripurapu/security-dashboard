# ─────────────────────────────────────────────────────────────
# SecurityDash — Environment Variables  (copy to .env)
#   cp .env.example .env
# Then fill in your real values in .env ONLY — never commit .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=secuser
POSTGRES_PASSWORD=your-strong-db-password-here
POSTGRES_DB=securitydash
DATABASE_URL=postgresql://secuser:your-strong-db-password-here@db:5432/securitydash

# API key for /report/* endpoints (REQUIRED — no default in production)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-api-key-here

# App user passwords (hashed by bcrypt at startup)
ADMIN_PASSWORD=your-admin-password-here
ANALYST_PASSWORD=your-analyst-password-here

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# Grafana SMTP (for email alerts)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
ALERT_EMAIL_FROM=your-gmail@gmail.com
ALERT_EMAIL_TO=your-receiver@email.com

# Slack webhook (optional — for Slack alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
